# Firebase Web App Configuration
# Get these values from:
# Firebase Console (https://console.firebase.google.com/) ->
# Project Settings -> General -> Your apps -> Web app config
VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=rajasthan-police-forensics.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rajasthan-police-forensics
VITE_FIREBASE_STORAGE_BUCKET=rajasthan-police-forensics.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Backend API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000

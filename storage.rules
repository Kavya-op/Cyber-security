rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated officers can access evidence files
    match /cases/{caseId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 50 * 1024 * 1024; // 50MB per upload
    }
  }
}
